# Attendance System Backend — Environment Variables
# Copy this file to .env and fill in the values.

# JWT secret for signing session tokens (use a random 32+ character string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# JWT token expiry (default: 20s)
JWT_EXPIRY=20s

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (from Project Settings → API → service_role key)
# WARNING: This key bypasses Row Level Security. Keep it secret!
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Frontend URL (for CORS and QR code URL construction)
FRONTEND_URL=https://your-frontend.vercel.app

# Server port (Render provides this automatically)
PORT=3000
